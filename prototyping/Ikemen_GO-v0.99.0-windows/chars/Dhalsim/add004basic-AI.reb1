;SF2_DHALSIM
;var(8)   = 1 face is 1P
;var(8) = 2 face is 2P
;var(14) = 1 is EX
;var(14) = 0 is SF
;
;exp 13500 is SF
;exp 13560 is EX
;
;1,1 LPK air sound
;1,2 MPK air sound
;1,3 HPK air sound
;2,1                              to                                2,6           is hitsound
;3,1 is guard sound
;4,1 is jump
;6,1 is super sound
;5,1 is through sound
;fight FX
;1 is  L             FX no
;2 is M or H FX no
;3 is guard no
;30 is super effect
;40 is super finish
;
;DAMAGE
;LPK is 30
;MPK is 45
;HPK is 60
;
;POWER ADD
;LPK is 30 and MPK is 45 and HPK is 60 same asd energy
;
;GivePower 
;LPK is 10 and MPK is 15 and HPK is 20 is 1/3 of energy
;juggle
;LPK juggle = 5 MPK juggle = 10
;
;
pausetime
;LPK pausetime is 11,11 MPK is 13,13  HPK is 15,15
;
;====================================================================================================================
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 30
liedown.time = 20
airjuggle = 15
juggle = 15
sparkno = F2
guard.sparkno = 40
KO.echo = 1
volume = 10
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           
yscale = 1           
ground.back = 20
ground.front = 20
air.back = 20
air.front = 20
z.width = 3          
height = 60	     
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 1.7
walk.back = -1.5
run.fwd  =  0
run.back = 0
jump.neu = 0,-7.5
jump.back = -1.7
jump.fwd = 1.7
runjump.back = -3.5,-9.5
runjump.fwd = 4,-9.5
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .3				;.44 is default	1 is light and bigger is faster
stand.friction =.82				; .85  
crouch.friction =.82				; .82 

[Quotes]
victory1 = "I will meditate and then destroy you."
victory2 = "Now you've realized the inner mysteries of yoga."
victory3 = "Mastery comes from within."
victory4 = "Your mind is full of wrong ideas. It's best your empty it."
victory5 = "You must master yourself before you can truly complete."

